node_modules/
dist/
.env
*.log
.DS_Store
*.db
*.db-wal
*.db-shm
# Images are ignored by default because the ones that turn up in this repo are
# screenshots, scratch exports and uploaded product media, none of which belong in git.
*.png
*.jpeg
*.jpg
# ...but the PWA install icons are source, not incidental output. The manifest referenced
# both of these for a long time while neither could ever be committed, which is a failed
# install and no error anywhere (#53). Anything under apps/dashboard/public/ is a shipped asset.
!apps/dashboard/public/*.png
# Same failure mode as #53, for the storefront brand lockup and the preserved original
# it was derived from: both are shipped assets, not incidental output.
!apps/storefront/public/brand/*.png
!docs/design/brand/*.png
nul
.playwright-mcp/
.tanstack/
*.tsbuildinfo

# vitest JSON report, written by CI to check the real-PostgreSQL suites actually ran
vitest-report.json

# Playwright E2E artifacts
e2e/playwright-report/
e2e/blob-report/
e2e/test-results/
e2e/playwright/.auth/

# Next.js build output
.next/
