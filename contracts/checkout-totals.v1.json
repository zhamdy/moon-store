        "pointsDiscountMinor": 0,
        "taxableBaseMinor": 333,
        "taxAmountMinor": 167,
        "tipMinor": 0,
        "amountDueMinor": 500,
        "earnedPoints": 0
      }
    }
  ],
  "splitPaymentCases": [
    {
      "name": "three-way-split-balances-to-the-cent",
      "amountDueMinor": 10000,
      "payments": [
        { "method": "Cash", "amountMinor": 3333 },
        { "method": "Cash", "amountMinor": 3333 },
        { "method": "Card", "amountMinor": 3334 }
      ],
      "expected": { "allocatedMinor": 10000, "isBalanced": true, "isOverpaid": false }
    },
    {
      "name": "underpaid-split-is-rejected",
      "amountDueMinor": 10000,
      "payments": [
        { "method": "Cash", "amountMinor": 3333 },
        { "method": "Card", "amountMinor": 3333 }
      ],
      "expected": { "allocatedMinor": 6666, "isBalanced": false, "isOverpaid": false }
    }
  ]
}
