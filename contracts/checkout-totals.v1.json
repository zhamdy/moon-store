        "taxAmountMinor": 14000,
        "tipMinor": 0,
        "amountDueMinor": 114000,
        "earnedPoints": 0
      }
    },
    {
      "name": "exclusive-tax",
      "input": {
        "items": [{ "unitPriceMinor": 100000, "quantity": 1 }],
        "manualDiscount": { "type": "fixed", "valueMinor": 0 },
        "couponDiscountMinor": 0,
        "loyalty": { "enabled": false, "pointsPerEgp": 0, "egpPerPointMinor": 0, "pointsRedeemed": 0 },
        "tax": { "enabled": true, "ratePercent": 14, "mode": "exclusive" },
        "tipMinor": 0
      },
      "expected": {
        "subtotalMinor": 100000,
        "manualDiscountMinor": 0,
        "couponDiscountMinor": 0,
        "pointsDiscountMinor": 0,
        "taxableBaseMinor": 100000,
        "taxAmountMinor": 14000,
        "tipMinor": 0,
        "amountDueMinor": 114000,
        "earnedPoints": 0
      }
    },
    {
      "name": "tip-after-tax-regression",
      "description": "Regression fixture for the historical tip-sign bug: a 25.00 EGP tip on an 850.00 EGP post-discount amount must yield 875.00 EGP due, never 825.00 EGP.",
      "input": {
        "items": [{ "unitPriceMinor": 85000, "quantity": 1 }],
        "manualDiscount": { "type": "fixed", "valueMinor": 0 },
        "couponDiscountMinor": 0,
        "loyalty": { "enabled": false, "pointsPerEgp": 0, "egpPerPointMinor": 0, "pointsRedeemed": 0 },
        "tax": { "enabled": false, "ratePercent": 0, "mode": "exclusive" },
        "tipMinor": 2500
      },
      "expected": {
        "subtotalMinor": 85000,
        "manualDiscountMinor": 0,
        "couponDiscountMinor": 0,
        "pointsDiscountMinor": 0,
        "taxableBaseMinor": 85000,
        "taxAmountMinor": 0,
        "tipMinor": 2500,
        "amountDueMinor": 87500,
        "earnedPoints": 0
      }
    },
    {
      "name": "full-combination-exclusive-tax",
      "description": "Manual percentage discount + coupon + loyalty redemption + exclusive tax + tip, in canonical order.",
      "input": {
        "items": [{ "unitPriceMinor": 200000, "quantity": 1 }],
        "manualDiscount": { "type": "percentage", "valuePercent": 10 },
        "couponDiscountMinor": 5000,
        "loyalty": { "enabled": true, "pointsPerEgp": 2, "egpPerPointMinor": 10, "pointsRedeemed": 300 },
        "tax": { "enabled": true, "ratePercent": 14, "mode": "exclusive" },
        "tipMinor": 5000
      },
      "expected": {
        "subtotalMinor": 200000,
        "manualDiscountMinor": 20000,
        "couponDiscountMinor": 5000,
        "pointsDiscountMinor": 3000,
        "taxableBaseMinor": 172000,
        "taxAmountMinor": 24080,
        "tipMinor": 5000,
        "amountDueMinor": 201080,
        "earnedPoints": 4021
      }
    },
    {
      "name": "half-minor-unit-rounding-boundary",
      "description": "Exercises the tie-rounding rule: a raw tax of 166.5 piasters rounds up to 167.",
      "input": {
        "items": [{ "unitPriceMinor": 333, "quantity": 1 }],
        "manualDiscount": { "type": "fixed", "valueMinor": 0 },
        "couponDiscountMinor": 0,
        "loyalty": { "enabled": false, "pointsPerEgp": 0, "egpPerPointMinor": 0, "pointsRedeemed": 0 },
        "tax": { "enabled": true, "ratePercent": 50, "mode": "exclusive" },
        "tipMinor": 0
      },
      "expected": {
        "subtotalMinor": 333,
        "manualDiscountMinor": 0,
