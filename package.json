{
  "name": "moon-store",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev:dashboard": "pnpm --filter moon-store-client dev",
    "build:dashboard": "pnpm --filter moon-store-client build",
    "dev:server": "pnpm --filter moon-store-server dev",
    "build:server": "pnpm --filter moon-store-server exec tsc",
    "dev:storefront": "pnpm --filter @moon/storefront dev",
    "build:storefront": "pnpm --filter @moon/storefront build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.0"
  },
  "lint-staged": {
    "apps/dashboard/src/**/*.{ts,tsx}": [
      "eslint --fix --config apps/dashboard/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/server/**/*.ts": [
      "eslint --fix --config apps/server/eslint.config.mjs",
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "eslint --fix --config e2e/eslint.config.mjs",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.28.2"
}
