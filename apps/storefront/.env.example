# Server-only, read at runtime (not inlined at build). Set in the storefront's
# runtime environment so one build can be promoted across environments.
API_URL=http://localhost:3001

# Browser-only, inlined at `next build`. Required for the bag: the cart quote
# (POST /api/v1/catalog/cart/quote) is called from the browser against this origin.
# The storefront's own origin must be listed in the API's STOREFRONT_ORIGINS, or
# every quote fails (the bag shows its failed state).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only, read at runtime. Sent as X-Catalog-Server-Token on catalog reads so
# SSR traffic uses the API's trusted rate-limit bucket; must match one entry of the
# API's CATALOG_SERVER_TOKEN (32+ bytes). Unset: every read is limited per IP, which
# is fine in dev and throttles a production storefront. Never prefix NEXT_PUBLIC_.
CATALOG_SERVER_TOKEN=

# Read at `next build`: the origin catalog images are served from (the API's
# MEDIA_PUBLIC_BASE_URL origin, or the S3/CDN host). Defaults to
# http://localhost:3001 outside production; unset in a production build, no remote
# image loads.
MEDIA_ORIGIN=http://localhost:3001

# Server-only: the storefront's public origin, used as metadataBase for canonical
# and alternate links. Defaults to http://localhost:3000, with a console error in
# production.
SITE_URL=http://localhost:3000

# Read at `next build`: whether Checkout exists in this build (plan 2026-09-15-002, CO-22).
# Unset: on in development, off in a production build (no Bag entry, /checkout is a 404).
# Preview deployments are production builds, so set it to `true` there. Leave it unset in
# production until a commerce/order strategy exists.
NEXT_PUBLIC_CHECKOUT_ENABLED=

# Server-only, read at runtime. The shared secret the API presents on
# POST /api/revalidate to drop catalog cache tags after a catalog write. Without it
# the route refuses every caller (401) and the storefront falls back to TTL-only
# invalidation, which cannot express a withdrawal: Next writes its data cache only on
# a 200, so a deactivated product's page would keep serving a purchasable 200
# indefinitely. Comma list (current,next) for rotation, each entry at least 32 bytes.
# Generate with: openssl rand -hex 32. Never prefix NEXT_PUBLIC_.
REVALIDATE_TOKEN=
