# Server-only, read at runtime (not inlined at build). Set in the storefront's
# runtime environment so one build can be promoted across environments.
API_URL=http://localhost:3001

# Browser-only, inlined at `next build`. Must be set before any build whose
# pages call the API from the client.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only, read at runtime. Sent as X-Catalog-Server-Token on catalog reads so
# SSR traffic uses the API's trusted rate-limit bucket; must match one entry of the
# API's CATALOG_SERVER_TOKEN (32+ bytes). Unset: every read is limited per IP, which
# is fine in dev and throttles a production storefront. Never prefix NEXT_PUBLIC_.
CATALOG_SERVER_TOKEN=

# Read at `next build`: the origin catalog images are served from (the API's
# MEDIA_PUBLIC_BASE_URL origin, or the S3/CDN host). Defaults to
# http://localhost:3001 outside production; unset in a production build, no remote
# image loads.
MEDIA_ORIGIN=http://localhost:3001

# Server-only: the storefront's public origin, used as metadataBase for canonical
# and alternate links. Defaults to http://localhost:3000, with a console error in
# production.
SITE_URL=http://localhost:3000
