{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      /* TEMPORARY workspace type-resolution workaround, not an architectural requirement.
         @tanstack/react-query's own .d.ts has no local @types/react and resolves pnpm's
         shared hoist, which held the dashboard's React 18 types here — not this app's own
         19 (apps/storefront/node_modules/@types/react resolves correctly on its own; this
         is a dependency's-own-types issue, the mirror of apps/dashboard/tsconfig.json's
         fix for the same hoist in the other direction). Pin them to this app's 19.
         Re-test whether this is still needed after upgrading React, TanStack Query,
         TypeScript or pnpm. Don't copy this into another package without first checking
         whether it actually hits the same hoist collision. */
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
